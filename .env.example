# ==============================================================================
# APEX ARENA — PRODUCTION ENVIRONMENT VARIABLE CONTRACT (.env.example)
# ==============================================================================

# Node / Runtime Configuration
NODE_ENV=production
PORT=3000

# Canonical Application URL & CORS Security
APP_URL=https://apexarena.et
ALLOWED_ORIGINS=https://apexarena.et,https://www.apexarena.et

# Authoritative PostgreSQL Database (Managed Cloud SQL / RDS / Neon)
DATABASE_URL=postgresql://user:password@host:5432/apex_arena?sslmode=require
PG_MAX_CONNECTIONS=20
PG_IDLE_TIMEOUT_MS=10000
PG_CONN_TIMEOUT_MS=5000
PG_STMT_TIMEOUT_MS=5000
PG_SSL=true
PG_SSL_REJECT_UNAUTHORIZED=true

# Authentication & Session Security (Min 32-character random high-entropy strings)
JWT_SECRET=your-32-char-min-high-entropy-jwt-secret-here
SESSION_SECRET=your-32-char-min-high-entropy-session-secret-here

# Football Data Providers (Primary & Secondary Ingestion & Sync)
FOOTBALL_DATA_API_TOKEN=your-football-data-org-api-token
API_FOOTBALL_KEY=your-api-football-key

# Ethiopian Payment Gateway Providers
# Telebirr (Ethio Telecom)
TELEBIRR_APP_ID=your-telebirr-app-id
TELEBIRR_APP_KEY=your-telebirr-app-key
TELEBIRR_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
TELEBIRR_SHORT_CODE=your-telebirr-short-code

# Chapa Financial Technologies
CHAPA_SECRET_KEY=CHASECK-live-your-chapa-secret-key
CHAPA_WEBHOOK_SECRET=your-chapa-webhook-secret-key

# Commercial Bank of Ethiopia (CBE Birr)
CBE_BIRR_MERCHANT_ID=your-cbe-merchant-id
CBE_BIRR_API_KEY=your-cbe-birr-api-key

# Disaster Recovery & Encryption (32-byte hex AES-256 key)
DISASTER_RECOVERY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Operational Alerts & Incident Notifications
ADMIN_NOTIFICATION_EMAIL=ops-alerts@apexarena.et

# AI Studio Capabilities
GEMINI_API_KEY=your-gemini-api-key-from-ai-studio
